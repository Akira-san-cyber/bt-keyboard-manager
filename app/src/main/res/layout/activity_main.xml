<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:text="Bluetooth Keyboard &amp; IME Control"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="Status"
                android:textColor="#BB86FC"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtKeyboardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/txtImeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/txtPermStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="Controls"
                android:textColor="#BB86FC"
                android:textSize="16sp"
                android:textStyle="bold" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchScreenKeyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="Always hide on-screen keyboard"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchBtKeyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="Auto-hide when a hardware keyboard is connected"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
        <Button
            android:id="@+id/btnSystemSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#6200EE"
            android:text="Open Physical Keyboard Settings"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnRunDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#03DAC5"
            android:text="Run Diagnostics"
            android:textColor="#000000" />
        <Button
            android:id="@+id/btnHideNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#3700B3"
            android:text="Dismiss Soft Keyboard Now"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnCopyAdb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#333333"
            android:text="Copy ADB Permission Command"
            android:textColor="#FFFFFF" />
        <TextView
            android:id="@+id/txtDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#03DAC5"
            android:textSize="12sp"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
